# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional: persist demo state in Supabase (required on Vercel). Leave empty to keep state in memory.
# Server-only — never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
